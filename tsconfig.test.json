{
  "extends": "@ringotangs/tsconfig/react",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "./src/**/*spec.ts",
    "./src/**/*spec.tsx",
    "./src/**/*test.ts",
    "./src/**/*test.tsx"
  ]
}
